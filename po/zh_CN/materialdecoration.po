msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>启用后：</p>\n"
"<ul>\n"
"<li>长按关闭按钮将窗口最小化到系统托盘 (需要 kwin-minimize2tray 插件)</li>\n"
"<li>长按最小化按钮将最小化除当前窗口外的所有窗口 (需要 Plasma 6.6 或更高版本)</li>\n"
"</ul>\n"
"</div></body></html>"

msgid "Long-press duration"
msgstr "长按持续时间"

msgid "Minimum reserved space"
msgstr "最小保留空间"

msgid "Ignore top-level menu labels"
msgstr "忽略顶级菜单标签"

msgid "Also ignore submenu labels"
msgstr "同时也忽略子菜单标签"

msgid "Paint a thin outline around the window"
msgstr "在窗口周围绘制细轮廓"

msgid "Show window title on mouse over"
msgstr "鼠标悬停时显示窗口标题"

