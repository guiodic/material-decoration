#: src/kcm/config.ui:412
#, kde-format
msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray "
"(requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the "
"current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>عند التفعيل:</p>\n"
"<ul>\n"
"<li>يؤدي الضغط المطوّل على زر الإغلاق إلى تصغير النافذة إلى صينية النظام (يتطلب إضافة kwin-minimize2tray)</li>\n"
"<li>يؤدي الضغط المطوّل على زر التصغير إلى تصغير جميع النوافذ عدا الحالية (يتطلب Plasma 6.6 أو أحدث)</li>\n"
"</ul>\n"
"</div></body></html>"

