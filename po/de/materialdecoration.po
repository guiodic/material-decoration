#: src/kcm/config.ui src/kcm/ExceptionDialog.cc
msgid "Restore snapped window state"
msgstr "Andockzustand von Fenstern wiederherstellen"

#: src/kcm/config.ui src/kcm/ExceptionDialog.cc
msgid "Restore saved edge snapping or custom tiling when a window reopens.\nWhen disabled, reopen it floating with its known normal size."
msgstr "Gespeichertes Andocken an Bildschirmrändern oder benutzerdefinierte Kacheln beim erneuten Öffnen wiederherstellen.\nWenn deaktiviert, wird das Fenster schwebend mit seiner bekannten normalen Größe geöffnet."

#: src/kcm/config.ui
msgid "Window management is disabled while Remember Window Positions is enabled in KWin Scripts."
msgstr "Die Fensterverwaltung ist deaktiviert, solange Remember Window Positions in den KWin-Skripten aktiviert ist."
