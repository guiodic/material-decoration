msgstr "Aktionen bei langem Drücken auf Fensterschaltflächen aktivieren"

msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>Wenn aktiviert:</p>\n"
"<ul>\n"
"<li>Langes Drücken der Schließen-Schaltfläche minimiert das Fenster im Systemabschnitt der Kontrollleiste (erfordert das Plugin kwin-minimize2tray)</li>\n"
"<li>Langes Drücken der Minimieren-Schaltfläche minimiert alle Fenster außer dem aktuellen (erfordert Plasma 6.6 oder neuer)</li>\n"
"</ul>\n"
"</div></body></html>"

msgid "Long-press duration"
msgstr "Dauer für langes Drücken"

msgid "Minimum reserved space"
msgstr "Minimal reservierter Platz"

msgid "Ignore top-level menu labels"
msgstr "Top-Level-Menübeschriftungen ignorieren"

msgid "Also ignore submenu labels"
msgstr "Auch Untermenü-Beschriftungen ignorieren"

msgid "Paint a thin outline around the window"
msgstr "Einen dünnen Umriss um das Fenster zeichnen"

msgid "Show window title on mouse over"
msgstr "Fenstertitel bei Maus-Hover anzeigen"

