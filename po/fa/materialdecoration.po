#: src/kcm/config.ui:412
#, kde-format
msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray "
"(requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the "
"current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>هنگام فعال بودن:</p>\n"
"<ul>\n"
"<li>فشار طولانی روی دکمهٔ بستن، پنجره را در سینی سیستم کمینه می‌کند (به افزونهٔ kwin-minimize2tray نیاز دارد)</li>\n"
"<li>فشار طولانی روی دکمهٔ کمینه‌سازی، همهٔ پنجره‌ها به‌جز پنجرهٔ کنونی را کمینه می‌کند (به Plasma 6.6 یا جدیدتر نیاز دارد)</li>\n"
"</ul>\n"
"</div></body></html>"

