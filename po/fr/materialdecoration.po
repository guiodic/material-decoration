msgstr "Activer les actions par appui long sur les boutons de fenêtre"

msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>Lorsqu'activé :</p>\n"
"<ul>\n"
"<li>Un appui long sur le bouton de fermeture réduit la fenêtre dans la boîte à miniatures (nécessite le plugin kwin-minimize2tray)</li>\n"
"<li>Un appui long sur le bouton de réduction réduit toutes les fenêtres sauf l'actuelle (nécessite Plasma 6.6 ou ultérieur)</li>\n"
"</ul>\n"
"</div></body></html>"

msgid "Long-press duration"
msgstr "Durée de l'appui long"

msgid "Minimum reserved space"
msgstr "Espace minimum réservé"

msgid "Ignore top-level menu labels"
msgstr "Ignorer les étiquettes de menu de premier niveau"

msgid "Also ignore submenu labels"
msgstr "Ignorer également les étiquettes des sous-menus"

msgid "Paint a thin outline around the window"
msgstr "Dessiner un contour fin autour de la fenêtre"

msgid "Show window title on mouse over"
msgstr "Afficher le titre de la fenêtre au survol de la souris"

