#: src/kcm/config.ui src/kcm/ExceptionDialog.cc
msgid "Restore saved edge snapping or custom tiling when a window reopens.\nWhen disabled, reopen it floating with its known normal size."
msgstr "Herstel de opgeslagen plaatsing aan schermranden of in aangepaste tegels bij het opnieuw openen.\nIndien uitgeschakeld wordt het venster zwevend geopend met de bekende normale grootte."

#: src/kcm/config.ui
msgid "Window management is disabled while Remember Window Positions is enabled in KWin Scripts."
msgstr "Vensterbeheer is uitgeschakeld zolang Remember Window Positions is ingeschakeld bij de KWin-scripts."
