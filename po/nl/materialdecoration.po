msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>Indien ingeschakeld:</p>\n"
"<ul>\n"
"<li>Lang indrukken van de sluitknop minimaliseert het venster naar het systeemvak (vereist de kwin-minimize2tray plug-in)</li>\n"
"<li>Lang indrukken van de minimaliseerknop minimaliseert alle vensters behalve de huidige (vereist Plasma 6.6 of nieuwer)</li>\n"
"</ul>\n"
"</div></body></html>"

