#: src/Button.cc:929
#, kde-format
msgid "Press and hold to minimize other windows"
msgstr "길게 눌러 다른 창 최소화"

#: src/Button.cc:932
#, kde-format
msgid "Press and hold to show snapping zones"
msgstr "길게 눌러 스냅 영역 표시"

