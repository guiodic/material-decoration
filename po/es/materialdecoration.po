msgstr "Activar acciones de pulsación larga en los botones de la ventana"

msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>Cuando está activado:</p>\n"
"<ul>\n"
"<li>Al mantener pulsado el botón de cerrar se minimiza la ventana a la bandeja del sistema (requiere el complemento kwin-minimize2tray)</li>\n"
"<li>Al mantener pulsado el botón de minimizar se minimizan todas las ventanas excepto la actual (requiere Plasma 6.6 o posterior)</li>\n"
"</ul>\n"
"</div></body></html>"

msgid "Long-press duration"
msgstr "Duración de la pulsación larga"

msgid "Minimum reserved space"
msgstr "Espacio mínimo reservado"

msgid "Ignore top-level menu labels"
msgstr "Ignorar etiquetas de menú de nivel superior"

msgid "Also ignore submenu labels"
msgstr "Ignorar también las etiquetas de los submenús"

msgid "Paint a thin outline around the window"
msgstr "Dibujar un contorno fino alrededor de la ventana"

msgid "Show window title on mouse over"
msgstr "Mostrar el título de la ventana al pasar el ratón"

