msgstr "Apri il popup di affiancamento al passaggio del mouse sul pulsante massimizza"

#: src/kcm/config.ui
msgid "Tiling popup hover delay"
msgstr "Ritardo di apertura del popup di affiancamento"

#: src/TilingPopup.cc
msgid "Custom tiling layout (Meta+T)"
msgstr "Schema di affiancamento personalizzato (Meta+T)"

#: src/TilingPopup.cc
