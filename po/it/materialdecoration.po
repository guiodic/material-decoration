msgid "Button Options"
msgstr "Opzioni dei Bottoni"

msgid "Allow window dragging from buttons"
msgstr "Consenti il trascinamento della finestra dai pulsanti"

msgid "Enable long-press actions on window buttons"
msgstr "Abilita le azioni di pressione prolungata sui pulsanti della finestra"

msgid ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>When enabled:</p>\n"
"<ul>\n"
"<li>Long-pressing the close button minimizes the window to the system tray (requires the kwin-minimize2tray plugin)</li>\n"
"<li>Long-pressing the minimize button minimizes all windows except the current one (requires Plasma 6.6 or later)</li>\n"
"</ul>\n"
"</div></body></html>"
msgstr ""
"<html><body><div style=\"width: 350px;\">\n"
"<p>Quando abilitato:</p>\n"
"<ul>\n"
"<li>La pressione prolungata del pulsante di chiusura minimizza la finestra nel vassoio di sistema (richiede il plugin kwin-minimize2tray)</li>\n"
"<li>La pressione prolungata del pulsante di minimizzazione riduce a icona tutte le finestre tranne quella corrente (richiede Plasma 6.6 o successivo)</li>\n"
"</ul>\n"
"</div></body></html>"

msgid "Long-press duration"
msgstr "Durata della pressione prolungata"

msgid "Minimum reserved space"
msgstr "Spazio minimo riservato"

msgid "Ignore top-level menu labels"
msgstr "Ignora le etichette dei menu di primo livello"

msgid "Also ignore submenu labels"
msgstr "Ignora anche le etichette dei sottomenu"

msgid "Paint a thin outline around the window"
msgstr "Disegna un sottile contorno attorno alla finestra"

msgid "Show window title on mouse over"
msgstr "Mostra il titolo della finestra al passaggio del mouse"

